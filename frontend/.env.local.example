# Backend API URL (change to production URL after deployment)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Better Auth Configuration
# MUST match backend secret exactly
BETTER_AUTH_SECRET=REPLACE_WITH_GENERATED_32_CHAR_SECRET

# Better Auth URL (change to production URL after deployment)
BETTER_AUTH_URL=http://localhost:3000

# Database URL (same as backend - Better Auth needs direct DB access)
# FOR VERCEL DEPLOYMENT: Use the connection string ending with "-pooler" (e.g. ep-xyz-pooler.aws.neon.tech)
DATABASE_URL=postgresql://[USERNAME]:[PASSWORD]@[HOST]-pooler.aws.neon.tech/[DATABASE]?sslmode=require
