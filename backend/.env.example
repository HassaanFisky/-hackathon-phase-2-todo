# Database Connection (Neon PostgreSQL)
# Get your connection string from https://neon.tech
DATABASE_URL=postgresql://[USERNAME]:[PASSWORD]@[HOST]/[DATABASE]?sslmode=require

# Authentication Secret (MUST be 32+ characters, same as frontend)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_GENERATED_32_CHAR_SECRET

# CORS Origins (comma-separated, add Vercel URL after deployment)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
